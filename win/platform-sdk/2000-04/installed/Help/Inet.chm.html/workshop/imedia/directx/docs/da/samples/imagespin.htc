<!-- Declare properties and default values -->
<PUBLIC:PROPERTY NAME="border" VALUE="false"/>
<PUBLIC:PROPERTY NAME="rotation" VALUE=0/>
<PUBLIC:PROPERTY NAME="src" />

<SCRIPT LANGUAGE="JScript">
// Create a DirectAnimation object
var oDA = document.createElement("OBJECT");
oDA.classid="CLSID:B6FFC24C-7E13-11D0-9B47-00C04FC2F51D";
oDA.height=250;							//height of DA control area
oDA.width=250;							//width of DA control area
oDA.title="DirectAnimation Object";
if (border.toUpperCase() == "TRUE") {
	oDA.style.borderWidth=2;			//set border if specified
	oDA.style.borderStyle="solid";
	oDA.style.position="relative";		
	oDA.style.left="10";				//move DA object to the right 
}
window.document.body.insertBefore(oDA);	//add the DA object to the HTML page
var m = oDA.MeterLibrary;				//reference to the statics object (meters)

if (src != null) {
	var fileImg = m.ImportImage(src);	//convert the image into a DAImage
	if (rotation > 0) {
		//Apply a rotation behavior to the image
		var rotImg = fileImg.Transform(m.Rotate2RateDegrees(rotation));	
	}
	else {
		var rotImg = fileImg;
	}
	oDA.Image = rotImg;	//set the DA control image to display the rotating image
	oDA.Start();		//start the DA control
}
</SCRIPT>