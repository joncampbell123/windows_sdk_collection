<scriptlet />

<PUBLIC:HTC>

<PUBLIC:ATTACH EVENT="onload" FOR="window" HANDLER="handle_window_load" />
<PUBLIC:PROPERTY NAME="MINHEAD" VALUE="2" />
<PUBLIC:PROPERTY NAME="MAXHEAD" VALUE="2" />

<SCRIPT>

function handle_window_load()
{
	BuildOutline(element, MINHEAD, MAXHEAD);
}

function BuildOutline(oElem, iMin, iMax)
{
	for (var iHead = iMin; iHead <= iMax; iHead++)
	{
		var collHn = window.document.all.tags("H" + iHead);
		for (var i = 0; i < collHn.length; i++)
		{
			var oHn = collHn(i);
			var sLI = oHn.innerText;
			var sBookmark = null;

			// anchor is already there, so use it
			if ((oHn.children.length > 0) && (oHn.children(0).tagName == "A"))
			{
				var oAnchor = oHn.children(0);
				sBookmark = oAnchor.name;
				if (sBookmark == "")
				{
					sBookmark = sLI;
					oAnchor.name = sLI;
				}

			}
			else // insert the anchor
			{
				sBookmark = sLI;
				oHn.innerHTML = '<A NAME="' + sLI + '">' + sLI + '</A>';
			}

			sLI = '<A HREF="#' + sBookmark + '">' + sLI + '</A>';
			sLI = '<LI>' + sLI;
			oElem.insertAdjacentHTML('beforeend', sLI);	
		}
	}
}

</SCRIPT>

</PUBLIC:HTC>