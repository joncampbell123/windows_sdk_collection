<HTML>

<HEAD>
  <TITLE>Create ASP files for Docs</TITLE>
  <STYLE>
    BODY { font: bold 10pt Verdana }
    A { text-decoration: underline }
  </STYLE>
</HEAD>

<SCRIPT language="JavaScript" src="/XML/_build/generate.js"></SCRIPT>

<SCRIPT for="window" event="onload">
  source = new ActiveXObject("Microsoft.XMLDOM");
  source.validateOnParse = false;

  ss = new ActiveXObject("Microsoft.XMLDOM");
  ss.validateOnParse = false;
  ss.load("/XML/_build/asp-docs.xsl");
  statusField.innerHTML = ss.parseError.reason;
</SCRIPT>

<BODY>
  <P>Handles files:
    <UL>
      <LI><A onclick="create('/XML/_source/xslguide/xsl-conformance.xml');">xsl-conformance.xml</A>
      <LI><A onclick="create('/XML/_source/xslguide/xsl-browsing.xml');">xsl-browsing.xml</A>
      <LI><A onclick="create('/XML/_source/xslguide/xsl-transforming.xml');">xsl-transforming.xml</A>
      <LI><A onclick="create('/XML/_source/xslguide/xsl-intro.xml');">xsl-intro.xml</A>
      <LI><A onclick="create('/XML/_source/xslguide/xsl-patterns.xml');">xsl-patterns.xml</A>
      <LI><A onclick="create('/XML/_source/xslguide/xsl-advanced.xml');">xsl-advanced.xml</A>
      <LI><A onclick="create('/XML/_source/xslguide/xsl-scripting.xml');">xsl-scripting.xml</A>
    </UL>
    <UL>
      <LI><A onclick="create('/XML/_source/xslguide/xsl-conformance.xml');
                      create('/XML/_source/xslguide/xsl-browsing.xml');
                      create('/XML/_source/xslguide/xsl-transforming.xml');
                      create('/XML/_source/xslguide/xsl-intro.xml');
                      create('/XML/_source/xslguide/xsl-patterns.xml');
                      create('/XML/_source/xslguide/xsl-advanced.xml');
                      create('/XML/_source/xslguide/xsl-scripting.xml')">all of the above</A>
    </UL>
  </P>
  <P><A onclick="ss.load('/XML/_build/asp-docs.xsl');">reload stylesheet</A></P>
  <P><A onclick="statusField.innerHTML='Ready'">clear log</A></P>
 
  <DIV id="statusField" STYLE="background-color:#EEEEEE; font:9pt Courier">Ready</DIV>
</BODY>

</HTML>
