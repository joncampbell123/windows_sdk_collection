<!-- this is a DTD for an XML BNF format -->

<!ELEMENT Data (Invoice | Products )*> 

<!ELEMENT Invoice (Item | Address)*>			
<!ATTLIST Invoice
	id	ID	#REQUIRED 
    	name CDATA #IMPLIED
	billto	IDREF	#IMPLIED
	shipto	IDREF	#IMPLIED
	amount	CDATA	#IMPLIED
    	items IDREFS #IMPLIED >
		
<!ELEMENT Address ANY>
<!ATTLIST Address
	id	ID	#REQUIRED 
	name	CDATA	#IMPLIED
	street	CDATA	#IMPLIED
	city	CDATA	#IMPLIED
	state	CDATA	#IMPLIED
	phone	CDATA	#IMPLIED >
	
<!ELEMENT Item ANY>		
<!ATTLIST Item
	id	ID	#REQUIRED 
	quantity	CDATA	#IMPLIED
	price		CDATA	#IMPLIED
	product		IDREF	#IMPLIED >

<!ELEMENT Products (Product)+>			
<!ELEMENT Product ANY>		
<!ATTLIST Product
	id	ID	#REQUIRED 
	company	CDATA	#IMPLIED
	name	CDATA	#IMPLIED
	price	CDATA	#IMPLIED
	>




	





