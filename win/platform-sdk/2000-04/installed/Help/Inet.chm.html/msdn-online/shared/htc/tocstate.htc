<scriptlet />

<PUBLIC:HTC>

<!--
	* Abstract: Wrap userData behavior to persist the state of the TOC. 
	*           Currently, state is limited to tracking expanded nodes.

	* Schema: <ROOTSTUB eh1="1" eh2="1" ... ehn="1" />
	*         ehn - a URL-encoded representation of a section heading. Encoding required to be a legal XML attrib name

	* Assertions: TOC is collapsed by default, so data is only stored for expanded TOC nodes

	* CreateKey - creates a key for the entry to be persisted
	* handle_propertychange - observe when lists expand and collapse
	* RestoreTOCState - Restore TOC state based on cache data
	* Scavenge - Compact XML cache
	* window_load - load XML store, and trigger restoration
	* window_unload - commit XML store

	To enable:
		Due to bug 51856 (behavior not instantiated when CSS is doc.written), attach this behavior
		from a style block within the document or as an in-line style.

		For RTW
		  1) add UL.clsTOCState {behavior:url('/sitebuilder/shared/htc/tocstate.htc')} to ie4-toc.css
		  2) modify top-level UL in toc.xsl by replacing STYLE="..." with CLASS="clsTOCState"

	Limitations:
		* Names are stored in a flat namespace (attributes of the XMLDocument root element.
		  Headings with the same name will collide and produce undesirable results.
		  If this is an issue, the behavior could 
			a) attach userdata to each expandable section, or 
			b) use a hierarchy within a single XML store
		* If a heading name is changed persistence for that node will break. The name is the key into the XML store.
-->

   <PUBLIC:ATTACH EVENT="onload" FOR="window" HANDLER="handle_window_load" />
   <PUBLIC:ATTACH EVENT="onunload" FOR="window" HANDLER="handle_window_unload" />

   <SCRIPT>
	var oRegPct = new RegExp("%", "g"); // init once; use many
	var m_bReady = false; // semaphore to prevent restore/propertychange conflict

	// sink property changes on LIs of class clsItems(Show|Hide)
	// when the property changes, cache the section heading
	function handle_propertychange()
	{
	   if (!m_bReady) return;

	   if ("className" == window.event.propertyName)
	   {
			var eSrc = window.event.srcElement;
			var oHeading = eSrc.parentElement.children(0);
			switch (eSrc.className)
			{
				case "clsItemsHide":
					element.removeAttribute(CreateKey(oHeading));
					break;
				case "clsItemsShow":
					element.setAttribute(CreateKey(oHeading), 1);
					break;
			}
	   }
	}

	function handle_window_load()
	{
	    element.addBehavior("#default#userdata");
	    if (!element.XMLDocument)
	    {
	   	   return;
	    }
        element.load("tocstate"); // load persisted TOC state info
        RestoreTOCState(element); // the top-level UL currently persists all the data in a flat namespace
        Scavenge(); // compact the cache

		m_bReady = true;
	}

	function handle_window_unload()
	{
		if (element.XMLDocument) element.save("tocstate"); // commit TOC state info to cache
	}

	// find expandable sections and restore their state
	function RestoreTOCState(oElem)
	{
		
		for (var i = 0; i < oElem.children.length; i++)
		{
			var oChild = oElem.children(i);
			
			if (oChild.tagName != "LI" || (oChild.className.toLowerCase() != "clsshowhide" && oChild.className.toLowerCase() != "clsshowhideshowing"))
			{
				continue;
			}

			var oA = oChild.children(0);
			if (oA.className.toLowerCase() != "clstocheading")
			{
				continue;
			}

			// Find collection of hidden articles identified by CLASS
			// We don't know the exact offset [either 1 or 2 today] because
			// a SCRIPT for new/updated items may be present
			var oList;
			for (var iChild = 1; iChild < oChild.children.length; iChild++)
			{
				oList = oChild.children(iChild);
				if (oList.className.toLowerCase() == "clsitemshide")
				{
					break;
				}
			}

			if (!oList)
			{
				continue;
			}

			// className changes when article list expands/contracts. 
			// Use this as the basis to cache state
			oList.onpropertychange = handle_propertychange;
			var sKey = CreateKey(oA);
			var iValue = 0;
			if ((iValue = element.getAttribute(sKey)) && iValue != 2)
			{
				// touch recognized nodes. Those that aren't touched will be purged from cache
				element.XMLDocument.documentElement.getAttributeNode(sKey).value = 2;
				oList.className = "clsItemsShow";
				oChild.className = "clsShowHideShowing"; 
				RestoreTOCState(oList); // Since this section was expanded, check for sub-sections
			}
		}
	}

	// Keep the cache from getting cluttered by taking out the trash
	function Scavenge()
	{
		var oAttribs = element.XMLDocument.documentElement.attributes;

		for (var i = 0; i < oAttribs.length; i++)
		{
			// Remove those items that haven't been touched
			// They are no longer represented in the TOC or their name has changed
			if (oAttribs(i).value == 1)
			{
				oAttribs.removeNamedItem(oAttribs(i).name);
			}
			else
			{
				oAttribs(i).value = 1;
			}
		}
	}

	// Create an acceptable attribute name based on the section name
	// names must be encoded so that they are acceptable to XML store (e.g. spaces are not allowed)
	var oRegPct = new RegExp("%", "g"); // init once; use many
	var oRegBadChars = new RegExp("[</+*@]", "g"); // chars that don't get escaped but cause MSXML to raise exception
	function CreateKey(oElem)
	{
		// setAttr balks if the key contains a space
		// probably balks on other characters too...
		var sKey = escape(oElem.innerText);
		sKey = sKey.replace(oRegPct, "_");
		return sKey.replace(oRegBadChars, "");
	}

   </SCRIPT>
</PUBLIC:HTC>