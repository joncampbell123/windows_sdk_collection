<HTML>

<HEAD>
  <TITLE>Create ASP files for Docs</TITLE>
  <STYLE>
    BODY { font: bold 10pt Verdana }
    A { text-decoration: underline }
  </STYLE>
</HEAD>

<SCRIPT language="JavaScript" src="/XML/_build/generate.js"></SCRIPT>

<SCRIPT for="window" event="onload">
  source = new ActiveXObject("Microsoft.XMLDOM");
  source.validateOnParse = false;

  ss = new ActiveXObject("Microsoft.XMLDOM");
  ss.validateOnParse = false;
  ss.load("/XML/_build/asp-docs.xsl");
  statusField.innerHTML = ss.parseError.reason;
</SCRIPT>

<BODY>
  <P>Handles files:
    <UL>
      <LI><A onclick="create('/XML/_source/reference/xmldom/messages.xml');">messages.xml</A>
    </UL>
  </P>
  <P><A onclick="ss.load('/XML/_build/asp-docs.xsl');">reload stylesheet</A></P>
  <P><A onclick="statusField.innerHTML='Ready'">clear log</A></P>
 
  <DIV id="statusField" STYLE="background-color:#EEEEEE; font:9pt Courier">Ready</DIV>
</BODY>

</HTML>
