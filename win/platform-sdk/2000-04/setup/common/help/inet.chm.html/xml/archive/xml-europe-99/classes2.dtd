<!-- this is a DTD for an XML BNF format -->

<!ELEMENT Data (StudentBody | Faculty | ClassList | Departments | Workgroups)*> 

<!ELEMENT StudentBody (Student)*>			
<!ELEMENT Student ANY>			
<!ATTLIST Student
	id	ID	#REQUIRED 
    name CDATA #IMPLIED
    attends IDREFS #IMPLIED >

<!ELEMENT Faculty (Teacher)*>			
<!ELEMENT Teacher ANY>		
<!ATTLIST Teacher
	id	ID	#REQUIRED 
    name CDATA #IMPLIED
    teaches IDREFS #IMPLIED >

<!ELEMENT ClassList (Class)*>			
<!ELEMENT Class (Assignment)*>		
<!ATTLIST Class
	id	ID	#REQUIRED 
    name CDATA #IMPLIED
    dept IDREF #IMPLIED
    taughtBy IDREF #IMPLIED 
    attendedBy IDREFS #IMPLIED>

<!ELEMENT Departments (Dept)*>			
<!ELEMENT Dept ANY>		
<!ATTLIST Dept
	id	ID	#REQUIRED 
    name CDATA #IMPLIED>

<!ELEMENT Assignment (p|Assignment)+>
<!ATTLIST Assignment	
	date	CDATA	#IMPLIED
	workgroup IDREFS #IMPLIED>

<!ELEMENT p (#PCDATA|Profref)*>
<!ELEMENT Profref (#PCDATA)>
<!ATTLIST Profref dueto IDREF #IMPLIED>

<!ELEMENT Workgroups (Workgroup)*>	
<!ELEMENT Workgroup ANY>
<!ATTLIST Workgroup
	id	ID	#REQUIRED 
	name	CDATA	#IMPLIED
	leader	IDREF	#IMPLIED
	group	IDREFS	#IMPLIED>
	





