NOTE="Remarque :  "
CAUTION="ATTENTION !"
WARNING="Avertissement.  "
OLCHARS=abcdefghijklmnopqrstuvwxyz
OLCLOSE1=.
OLCLOSE2=)
ULITEMID1=o
ULITEMID2=-
ULITEMID3=--

REM=" WORDS defines the characters that make words.  This is used for"
REM=" searching and data compression.  The following is for Code page 437."

GRAMMER
WORDS=0 - 9 + A - Z + a - z +
Ä + Å + Ç + É + Ö + á + à + â + ä + ã + å + ê + î + ñ + ó + ò + ô + ö
EGRAMMER
