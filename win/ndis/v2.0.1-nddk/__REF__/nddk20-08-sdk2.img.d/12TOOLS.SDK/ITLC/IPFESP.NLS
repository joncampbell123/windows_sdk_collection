NOTE="Nota:  "
CAUTION=PRECAUCION:
WARNING="Aviso:  "
OLCHARS=abcdefghijklmn§opqrstuvwxyz
OLCLOSE1=.
OLCLOSE2=)
ULITEMID1=o
ULITEMID2=-
ULITEMID3=--

REM=" WORDS defines the characters that make words.  This is used for"
REM=" searching and data compression.  The following is for Code page 850."

GRAMMER
WORDS=0 - 9 + A - Z + a - z +
Ä + Å + Ç + Ö + á + ä + ã + ê + ï + ö + † + ° + ¢ + £ + § + • + µ + ∑ + ‘ + ÷ +
ÿ + ‡ + „ + È
EGRAMMER
