
;  Lan Manager initialization file, for server configuration.

[networks]
; This info is read by redir at device init time.  It is available to
  net1 = netbeui$,0


[workstation]
computername = PINSRV

; The following parameters generally do not need to be
; changed by the user.

charcount = 16
chartime = 250
charwait = 3600
domain = LANGRP
keepconn = 600
keepsearch = 600
mailslots = yes
maxcmds = 16
maxerrorlog = 100
maxthreads = 10
maxwrkcache = 64
numalerts = 12
numcharbuf = 12
numdgrambuf = 28
numservices = 8
numworkbuf = 24
othdomains = 
printbuftime = 90
sesstimeout = 45
sizcharbuf = 512
sizerror = 1024
sizworkbuf = 4096

; The next lines help you to locate bits in the wrkheuristics entry.
;			    1         2         3
;		  01234567890123456789012345678901
  wrkheuristics = 11111111213111111100010111201110

wrknets = net1 
wrkservices = MESSENGER, NETPOPUP

[messenger]
logfile = messages.log
sizmessbuf = 4096

[netshell]
  colors =
refresh = 15
remote = 
username = PINSRV

[server]
alertnames = 
auditing = 
autodisconnect = 120
autoprofile = load
maxusers = 32
noauditing =
security = user
srvcomment = PERFORMANCE SERVER

; The following parameters generally do not need to be
; changed by the user.  NOTE:  srvnets= is represented in
; the server info struct as a 16-bit lan mask.  Srvnet names
; are converted to indexes within [networks] for the named nets.

accessalert = 5
alertsched = 5
diskalert = 300
erroralert = 5
guestacct = GUEST
logonalert = 5
maxauditlog = 100
maxchdevjob = 6
maxchdevq = 2
maxchdevs = 2
maxconnections = 128
maxlocks = 64
maxopens = 64
maxsearches = 50
maxsessopens = 50
maxsessreqs = 50
maxsessvcs = 1
maxshares = 16
netioalert = 5
numadmin = 2
numbigbuf = 3
numfiletasks = 4
numreqbuf = 72
sizreqbuf = 4096
srvanndelta = 3000
srvannounce = 60

; The next lines help you to locate bits in the srvheuristics entry.
;		  	    1
;		  0123456789012345678
  srvheuristics = 1111015111121100113

srvhidden = no
srvnets = net1 
srvservices = 
userpath = accounts\userdirs
autopath = srvauto.pro

[alerter]
sizalertbuf = 3072

[netrun]
maxruns = 3
runpath = 

[replicator]
replicate = import
exportpath = repl\export
importpath = repl\import
logon = user
password = 
tryuser = no
interval = 5
guardtime = 2
pulse = 3
random = 60
exportlist =
importlist =

[ups]
messdelay = 5
messtime = 120
recharge = 100
signals = 100
voltlevels = 100
batterytime = 0
cmdfile =

[netlogon]
pulse = 300
randomize = 30
scripts = repl\import\scripts
update = yes

[remoteboot]
  configfile = dosbb.cnf
  maxthreads = 10
  rpldir = rpl
  rpl1 = rplnet1.dll rplnet2.dll rploem.dll

[services]
; Correlates name of service to pathname of service program.
; The pathname must be either
;	1) an absolute path (including the drive specification)
;			OR
;       2) a path relative to the LanMan root

  workstation = services\wksta.exe
  server = services\netsvini.exe
  messenger = services\msrvinit.exe
  netpopup = services\netpopup.exe
  alerter = services\alerter.exe
  netrun = services\runservr.exe
  replicator = services\replicat.exe
  ups = services\ups.exe
  netlogon = services\netlogon.exe
  remoteboot = services\rplservr.exe
  timesource = services\timesrc.exe
  remerrlog = services\relsrvc.exe
