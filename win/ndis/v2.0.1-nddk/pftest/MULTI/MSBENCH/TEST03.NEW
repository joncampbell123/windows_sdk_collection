@echo off
rem test03.bat
rem This batch file runs copy tests. It is assumed that:
rem   1) the default drive is T: which is redirected to the test server 
rem   2) the client has a hard disk, drive C:
rem The results of the tests are written to file test03.out.
rem The tests use a wildcard pattern of cf*.*
rem The file sizes are: 300, 2048, 48KB, 200KB, and 1MB.
rem  The names are the files are cf300.001, cf300.002,... cf300.0nn,
rem  cf2048.001,..., cf48K.001, etc.
echo on

if not exist %home%\copyfils\cf300.00%machine% copy %home%\copyfils\cf*.001 %home%\copyfils\cf*.00%machine%
attrib +r cf*.00%machine%
del %home%\copyfils\rc*.00%machine%

call sync
if not %machine%==1 copy %home%\copyfils\cf*.00%machine% %home%\copyfils\rc*.00%machine% >nul
:loop1
if not %machine%==1 copy %home%\copyfils\cf*.00%machine% %home%\copyfils\rc*.00%machine% >nul
if not %machine%==1 if not exist %home%\sync\ready.1 goto loop1
if not %machine%==1 goto next1
%root%\sleep 3
time 0
copy %home%\copyfils\cf*.00%machine% %home%\copyfils\rc*.00%machine% >>%output%\test03.out
time >>%output%\test03.out <%root%\cr.dat
:next1

call sync
md c:%root%\temp
del c:\%root%\temp\rc*.00%machine%

call sync
if not %machine%==1 copy %home%\copyfils\cf*.00%machine% c:\%root%\temp\rc*.00%machine% >nul
:loop2
if not %machine%==1 copy %home%\copyfils\cf*.00%machine% c:\%root%\temp\rc*.00%machine% >nul
if not %machine%==1 if not exist %home%\sync\ready.1 goto loop2
if not %machine%==1 goto next2
%root%\sleep 3
time 0
copy %home%\copyfils\cf*.00%machine% c:\%root%\temp\rc*.00%machine% >>%output%\test03.out
time >>%output%\test03.out <%root%\cr.dat
:next2
call sync
rename c:\%root%\temp\rc*.00%machine% cf*.00%machine%
del %home%\copyfils\rc*.00%machine%

call sync
if not %machine%==1 copy c:\%root%\temp\cf*.00%machine% %home%\copyfils\rc*.00%machine% >nul
:loop3
if not %machine%==1 copy c:\%root%\temp\cf*.00%machine% %home%\copyfils\rc*.00%machine% >nul
if not %machine%==1 if not exist %home%\sync\ready.1 goto loop3
if not %machine%==1 goto next3
%root%\sleep 3
time 0
copy c:\%root%\temp\cf*.00%machine% %home%\copyfils\rc*.00%machine% >>%output%\test03.out
time >>%output%\test03.out <%root%\cr.dat
:next3

del c:%root%\temp\*.00%machine%
rd c:%root%\temp

