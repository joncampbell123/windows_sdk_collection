;	SCCSID = @(#)absegs.inc	5.2 87/01/21
ABS0		segment at 00H			; real mode or INT 13H
ABS0		ends				;   segments
						;   ...
RomData 	segment at 40H			;   ...
RomData 	ends				;   ...
						;   ...
RomCode 	segment at 0F000H		;   ...
RomCode 	ends				;   ...
						;   ...
						;   ...
DDDHeader	segment word public 'BDATA'     ; disk device driver header
DDDHeader	ends				;   ...

BioData 	segment word public 'BDATA'     ; data segment
BioData 	ends				;   ...

ScratchData	segment word public 'BDATA'     ; data segment scratch buffer
ScratchData	ends				;   ...
						;   ...
BDSChain	segment word public 'BDATA'     ; BDS chain segment
BDSChain	ends				;   ...
						;   ...
DataInit	segment word public 'BDATA'     ; throw away data
DataInit	ends				;   ...
						;   ...
Code		segment word public 'CODE'      ; code segment
Code		ends				;   ...
						;   ...
BiosExtDrv	segment para public 'CODE'      ; external 3.5 inch drive
BiosExtDrv	ends				; support
						;   ...
CodeInit	segment para public 'CODE'    ; throw away code
CodeInit	ends			      ;   ...
						;   ...
BiosGroup	group	DDDHeader,BioData,BDSChain,DataInit
BiosSeg 	group	Code,BiosExtDrv,CodeInit

DataOffset	equ	offset BiosGroup:	; offset equates
CodeOffset	equ	offset BiosSeg: 	;   ...

STACK	segment word stack 'BSS'        ; prevents warning messages
STACK	ends				;   ...
