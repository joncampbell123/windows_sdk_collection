#
#     MAKEFILE FOR OS/2 DISK DEVICE DRIVER 
#
# Will build both a debug and a normal version of the disk driver.


#       DEFINITIONS FOR ASSEMBLER

INC=    /I. /I..\..\DOS /I..\..\INC

# 5.1 tools
LINK=link
MASM=masm

#       LIST OF OBJECT FILES FOR AT DRIVER

OBJ=    ABSUBR.OBJ ATINT13.OBJ ABDSK1.OBJ ATDSK2.OBJ ATDSK3.OBJ  \
        ABDSK4.OBJ ABDSK5.OBJ ABDSK6.OBJ ABINIT.OBJ ATCACHE.OBJ

#        CREATE AT DRIVER

ABDSK1.OBJ: ABDSK1.ASM ATSTATE.INC ABDDRV.INC ..\..\INC\DEVSYM.INC \
         ..\..\INC\DEVHDR.INC ABDSKEQU.INC ..\..\INC\ERROR.INC \
         ..\..\INC\DEVHLP.INC ..\..\INC\IBMROM.INC ABMAC.INC \
         ..\..\INC\STRUC.INC ABSEGS.INC ABDEBUG.INC
        $(MASM) /MX $(INC) $*.ASM;

ABDSK4.OBJ: ABDSK4.ASM ..\..\INC\INFOSEG.INC ABDDRV.INC \
         ..\..\INC\DEVSYM.INC ..\..\INC\DEVHDR.INC ABDSKEQU.INC \
         ..\..\INC\DEVHLP.INC ABMAC.INC ..\..\INC\STRUC.INC ABSEGS.INC \
         ABDEBUG.INC
        $(MASM) /MX $(INC) $*.ASM;

ABDSK5.OBJ: ABDSK5.ASM ..\..\INC\ERROR.INC ..\..\DOS\BPB.INC \
         ABDEBUG.INC ABDDRV.INC ..\..\INC\DEVSYM.INC ..\..\INC\DEVHDR.INC \
         ABDSKEQU.INC ABMAC.INC ..\..\INC\STRUC.INC ABSEGS.INC
        $(MASM) /MX $(INC) $*.ASM;

ABDSK6.OBJ: ABDSK6.ASM ..\..\INC\ERROR.INC ..\..\INC\DEVHLP.INC \
         ABIOCTL.INC ABDDRV.INC ..\..\INC\DEVSYM.INC ..\..\INC\DEVHDR.INC \
         ABDSKEQU.INC ..\..\DOS\BPB.INC ABMAC.INC ..\..\INC\STRUC.INC \
         ..\..\DOS\DOSMAC.INC ABSEGS.INC ABDEBUG.INC
        $(MASM) /MX $(INC) $*.ASM;

ABINIT.OBJ: ABINIT.ASM ..\..\INC\DCONFIG.INC ATSTATE.INC ABDDRV.INC \
         ..\..\INC\DEVSYM.INC ..\..\INC\DEVHDR.INC ABDSKEQU.INC \
         ..\..\DOS\BPB.INC ..\..\INC\ERROR.INC ..\..\INC\DEVHLP.INC \
         ..\..\INC\ABINT13.INC ..\..\INC\IBMROM.INC ABMAC.INC \
         ..\..\INC\STRUC.INC ABSEGS.INC ABDEBUG.INC
        $(MASM) /MX $(INC) $*.ASM;

ABSUBR.OBJ: ABSUBR.ASM ..\..\INC\IBMROM.INC ..\..\INC\ERROR.INC \
         ..\..\DOS\DOSMAC.INC ..\..\INC\DEVHLP.INC ABIOCTL.INC \
         ..\..\DOS\BPB.INC ABDDRV.INC ..\..\INC\DEVSYM.INC \
         ..\..\INC\DEVHDR.INC ABDSKEQU.INC ABMAC.INC ..\..\INC\STRUC.INC \
         ABSEGS.INC ABDEBUG.INC
        $(MASM) /MX $(INC) $*.ASM;

ATCACHE.OBJ: ATCACHE.ASM ATCACHE.INC ABSEGS.INC ABDDRV.INC \
	 ..\..\INC\DEVSYM.INC ..\..\INC\DEVHDR.INC ..\..\INC\DEVHLP.INC \
	 ..\..\DOS\DOSMAC.INC
	$(MASM) /MX $(INC) $*.ASM;

ATDSK2.OBJ: ATDSK2.ASM ..\..\INC\IBMROM.INC ..\..\INC\ABINT13.INC \
         ABIOCTL.INC ATSTATE.INC ABDDRV.INC ..\..\INC\DEVSYM.INC \
         ..\..\INC\DEVHDR.INC ABDSKEQU.INC ..\..\INC\ERROR.INC \
         ..\..\INC\DEVHLP.INC ..\..\DOS\BPB.INC ABMAC.INC ..\..\INC\STRUC.INC \
         ABSEGS.INC ABDEBUG.INC
        $(MASM) /MX $(INC) $*.ASM;

ATDSK3.OBJ: ATDSK3.ASM ..\..\INC\IBMROM.INC ..\..\INC\ABINT13.INC \
         ABIOCTL.INC ATSTATE.INC ABDDRV.INC ..\..\INC\DEVSYM.INC \
         ..\..\INC\DEVHDR.INC ABDSKEQU.INC ..\..\INC\ERROR.INC \
         ..\..\INC\DEVHLP.INC ..\..\DOS\BPB.INC ABMAC.INC ..\..\INC\STRUC.INC \
         ABSEGS.INC ABDEBUG.INC
        $(MASM) /MX $(INC) $*.ASM;

ATINT13.OBJ: ATINT13.ASM ..\..\INC\STRUC.INC ..\..\DOS\DOSMAC.INC \
         ABDEBUG.INC ..\..\INC\IBMROM.INC ..\..\INC\ABINT13.INC \
         ..\..\INC\DEVHLP.INC ABDDRV.INC ..\..\INC\DEVSYM.INC \
         ..\..\INC\DEVHDR.INC ABDSKEQU.INC ABMAC.INC ..\..\INC\STRUC.INC \
         ABSEGS.INC
        $(MASM) /MX $(INC) $*.ASM;

DISK01.SYS: $(OBJ) DISK01.LRF DISK01.DEF
            $(LINK) @DISK01.LRF;
	    MAPSYM DISK01

DOBJ=    ABSUBRD.OBJ ATINT13D.OBJ ABDSK1D.OBJ ATDSK2D.OBJ ATDSK3D.OBJ  \
        ABDSK4D.OBJ ABDSK5D.OBJ ABDSK6D.OBJ ABINITD.OBJ ATCACHED.OBJ

ABDSK1D.OBJ: ABDSK1.ASM ATSTATE.INC ABDDRV.INC ..\..\INC\DEVSYM.INC \
         ..\..\INC\DEVHDR.INC ABDSKEQU.INC ..\..\INC\ERROR.INC \
         ..\..\INC\DEVHLP.INC ..\..\INC\IBMROM.INC ABMAC.INC \
         ..\..\INC\STRUC.INC ABSEGS.INC ABDEBUG.INC
        $(MASM) /MX /DDEBUGO $(INC) ABDSK1.ASM,$*.OBJ;

ABDSK4D.OBJ: ABDSK4.ASM ..\..\INC\INFOSEG.INC ABDDRV.INC \
         ..\..\INC\DEVSYM.INC ..\..\INC\DEVHDR.INC ABDSKEQU.INC \
         ..\..\INC\DEVHLP.INC ABMAC.INC ..\..\INC\STRUC.INC ABSEGS.INC \
         ABDEBUG.INC
        $(MASM) /MX /DDEBUGO $(INC) ABDSK4.ASM,$*.OBJ;

ABDSK5D.OBJ: ABDSK5.ASM ..\..\INC\ERROR.INC ..\..\DOS\BPB.INC \
         ABDEBUG.INC ABDDRV.INC ..\..\INC\DEVSYM.INC ..\..\INC\DEVHDR.INC \
         ABDSKEQU.INC ABMAC.INC ..\..\INC\STRUC.INC ABSEGS.INC
        $(MASM) /MX /DDEBUGO $(INC) ABDSK5.ASM,$*.OBJ;

ABDSK6D.OBJ: ABDSK6.ASM ..\..\INC\ERROR.INC ..\..\INC\DEVHLP.INC \
         ABIOCTL.INC ABDDRV.INC ..\..\INC\DEVSYM.INC ..\..\INC\DEVHDR.INC \
         ABDSKEQU.INC ..\..\DOS\BPB.INC ABMAC.INC ..\..\INC\STRUC.INC \
         ..\..\DOS\DOSMAC.INC ABSEGS.INC ABDEBUG.INC
        $(MASM) /MX /DDEBUGO $(INC) ABDSK6.ASM,$*.OBJ;

ABINITD.OBJ: ABINIT.ASM ..\..\INC\DCONFIG.INC ATSTATE.INC ABDDRV.INC \
         ..\..\INC\DEVSYM.INC ..\..\INC\DEVHDR.INC ABDSKEQU.INC \
         ..\..\DOS\BPB.INC ..\..\INC\ERROR.INC ..\..\INC\DEVHLP.INC \
         ..\..\INC\ABINT13.INC ..\..\INC\IBMROM.INC ABMAC.INC \
         ..\..\INC\STRUC.INC ABSEGS.INC ABDEBUG.INC
        $(MASM) /MX /DDEBUGO $(INC) ABINIT.ASM,$*.OBJ;

ABSUBRD.OBJ: ABSUBR.ASM ..\..\INC\IBMROM.INC ..\..\INC\ERROR.INC \
         ..\..\DOS\DOSMAC.INC ..\..\INC\DEVHLP.INC ABIOCTL.INC \
         ..\..\DOS\BPB.INC ABDDRV.INC ..\..\INC\DEVSYM.INC \
         ..\..\INC\DEVHDR.INC ABDSKEQU.INC ABMAC.INC ..\..\INC\STRUC.INC \
         ABSEGS.INC ABDEBUG.INC
        $(MASM) /MX /DDEBUGO $(INC) ABSUBR.ASM,$*.OBJ;

ATCACHED.OBJ: ATCACHE.ASM ATCACHE.INC ABSEGS.INC ABDDRV.INC \
	 ..\..\INC\DEVSYM.INC ..\..\INC\DEVHDR.INC ..\..\INC\DEVHLP.INC \
	 ..\..\DOS\DOSMAC.INC
	$(MASM) /MX /DDEBUGO $(INC) ATCACHE.ASM,$*.OBJ;

ATDSK2D.OBJ: ATDSK2.ASM ..\..\INC\IBMROM.INC ..\..\INC\ABINT13.INC \
         ABIOCTL.INC ATSTATE.INC ABDDRV.INC ..\..\INC\DEVSYM.INC \
         ..\..\INC\DEVHDR.INC ABDSKEQU.INC ..\..\INC\ERROR.INC \
         ..\..\INC\DEVHLP.INC ..\..\DOS\BPB.INC ABMAC.INC ..\..\INC\STRUC.INC \
         ABSEGS.INC ABDEBUG.INC
        $(MASM) /MX /DDEBUGO $(INC) ATDSK2.ASM,$*.OBJ;

ATDSK3D.OBJ: ATDSK3.ASM ..\..\INC\IBMROM.INC ..\..\INC\ABINT13.INC \
         ABIOCTL.INC ATSTATE.INC ABDDRV.INC ..\..\INC\DEVSYM.INC \
         ..\..\INC\DEVHDR.INC ABDSKEQU.INC ..\..\INC\ERROR.INC \
         ..\..\INC\DEVHLP.INC ..\..\DOS\BPB.INC ABMAC.INC ..\..\INC\STRUC.INC \
         ABSEGS.INC ABDEBUG.INC
        $(MASM) /MX /DDEBUGO $(INC) ATDSK3.ASM,$*.OBJ;

ATINT13D.OBJ: ATINT13.ASM ..\..\INC\STRUC.INC ..\..\DOS\DOSMAC.INC \
         ABDEBUG.INC ..\..\INC\IBMROM.INC ..\..\INC\ABINT13.INC \
         ..\..\INC\DEVHLP.INC ABDDRV.INC ..\..\INC\DEVSYM.INC \
         ..\..\INC\DEVHDR.INC ABDSKEQU.INC ABMAC.INC ..\..\INC\STRUC.INC \
         ABSEGS.INC
        $(MASM) /MX /DDEBUGO $(INC) ATINT13.ASM,$*.OBJ;

DISK01D.SYS: $(DOBJ) DISK01D.LRF DISK01.DEF
            $(LINK) @DISK01D.LRF;
	    MAPSYM DISK01D
